# ChainLens Frontend — Production Environment Variables
# Copy this file to .env.production and fill in the real values.
# DO NOT commit .env.production to Git.

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
# Full URL of the deployed FastAPI backend (Railway / Render).
VITE_API_URL=https://your-backend-url.up.railway.app

# ------------------------------------------------------------------------------
# Blockchain Contract Addresses (fill after Phase 1 deployment)
# ------------------------------------------------------------------------------
VITE_PRODUCT_REGISTRY_CONTRACT=0xYOUR_PRODUCT_REGISTRY_CONTRACT_ADDRESS
VITE_SHIPMENT_TRACKER_CONTRACT=0xYOUR_SHIPMENT_TRACKER_CONTRACT_ADDRESS

# ------------------------------------------------------------------------------
# WalletConnect
# ------------------------------------------------------------------------------
# Get your project ID from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
