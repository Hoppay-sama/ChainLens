# Copy this file to .env and update the values for your local Docker Compose environment

# PostgreSQL
POSTGRES_USER=veritras
POSTGRES_PASSWORD=changeme
POSTGRES_DB=veritras

# Backend
DATABASE_URL=postgresql://veritras:changeme@postgres:5432/veritras
CORS_ORIGINS=http://localhost:3000

# Frontend (Vite build-time arg)
VITE_API_URL=http://localhost:8000

# Optional: Sentry error tracking
SENTRY_DSN=
