# Copy this file to .env and update the values for your local Docker Compose environment

# PostgreSQL
POSTGRES_USER=veritras
POSTGRES_PASSWORD=changeme
POSTGRES_DB=veritras

# Backend
DATABASE_URL=postgresql://veritras:changeme@postgres:5432/veritras
CORS_ORIGINS=http://localhost:3000

# Blockchain (required for indexer and on-chain writes)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
PRODUCT_REGISTRY_CONTRACT=0x1F76018532D619194f6628ADc186e3c86FcB5AaA
SHIPMENT_TRACKER_CONTRACT=0x95b09C0aeD53f6b63C072F4ecaC18861FcbBFB30
INDEXER_POLL_INTERVAL=15
INDEXER_START_BLOCK=10779035

# Auth
JWT_SECRET_KEY=change-me-in-production-to-a-random-64-char-string

# Frontend (Vite build-time arg)
VITE_API_URL=http://localhost:8000

# Optional: Sentry error tracking
SENTRY_DSN=
